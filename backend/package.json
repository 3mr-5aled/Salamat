{
  "name": "hospital-api",
  "version": "1.0.0",
  "description": "Hospital Management System API with appointment booking, patient management, and administrative features",
  "main": "server.js",
  "imports": {
    "#root/*": "./*",
    "#src/*": "./src/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middlewares/*",
    "#validators/*": "./src/validators/*",
    "#utils/*": "./src/utils/*",
    "#services/*": "./src/services/*",
    "#config/*": "./src/config/*"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node src/config/seed.js",
    "seed:all": "node src/config/seed-all.js"
  },
  "keywords": [],
  "author": "Amr Khaled Morcy",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.3.0",
    "mongoose": "^6.0.13",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "uuid": "^11.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
